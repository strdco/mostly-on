# Mostly-On configuration. Copy to .env and fill in the values marked REQUIRED.
# docker compose reads .env automatically; for local `npm run dev` it is
# loaded with node --env-file.

# --- Web UI login -------------------------------------------------------------
# The first user, created when Mostly-On starts with no users. After that,
# users are managed on the Users page and these two are not used.
# Locked out? docker compose exec controller npm run reset-password -- <user>
ADMIN_USER=admin
# REQUIRED for the first start. scrypt hash of the first user's password. Generate with:
#   npm run hash-password
# (format scrypt:N:r:p:salt:hash; contains no '$', safe for compose)
ADMIN_PASSWORD_HASH=

# REQUIRED. 32 random bytes, base64. Encrypts the SQL Server credentials stored
# in the catalog. Generate with: npm run gen-secret
# Losing it means re-entering every server password; changing it requires the same.
SECRET_KEY=

# Public URL of the dashboard. Used for the CSRF origin check and for links in
# notifications. If it starts with https://, cookies are marked Secure.
PUBLIC_URL=http://localhost:8080

# Override the Secure cookie flag (default: true when PUBLIC_URL is https).
#COOKIE_SECURE=false

# Login session lifetime in hours.
SESSION_TTL_HOURS=12

# --- Controller ---------------------------------------------------------------
# HTTP port inside the container.
#PORT=8080

# Where the SQLite catalog lives (container default /data, a volume).
#DATA_DIR=/data

# Where the shared backup volume is mounted in the controller (default /backup).
#BACKUP_ROOT=/backup

# Time zone for schedule times (daily/weekly "at HH:MM").
TZ=UTC

# debug | info | warn | error
LOG_LEVEL=info

# --- Notifications (Pushover) -------------------------------------------------
# Leave empty to disable. Get them from https://pushover.net/apps
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Only change for testing against a mock endpoint.
#PUSHOVER_API_URL=https://api.pushover.net/1/messages.json

# --- Demo compose only --------------------------------------------------------
# sa password for the two demo SQL Server containers (must meet SQL Server
# complexity rules: 8+ chars, three of upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=

# Password of the restricted SQL login "mostly_on" that the demo's sql-setup
# service creates on both SQL Servers. Register the servers in the dashboard
# with this login, not sa.
MOSTLY_ON_SQL_PASSWORD=
